# Production backend environment - Sprint 18 item 718.
# Copy to an uncommitted deployment env file or inject through a secret manager.
# Required secrets intentionally have no example values.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Required database connection. Keep credentials separate from DB_URL.
DB_URL=jdbc:postgresql://postgres:5432/bwc_campaign
DB_USERNAME=bwc_app
DB_PASSWORD=
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
POSTGRES_VOLUME_NAME=bwc_postgres_prod_data
POSTGRES_SHM_SIZE=256m
POSTGRES_STOP_GRACE_PERIOD=60s
POSTGRES_INITDB_ARGS=--data-checksums --encoding=UTF8

# Scheduled custom-format PostgreSQL backups. Copy this volume to encrypted off-host storage.
POSTGRES_BACKUP_VOLUME_NAME=bwc_postgres_backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
BACKUP_HEALTH_MAX_AGE_MINUTES=1560

# Required authentication and browser origin policy. Generate JWT_SECRET cryptographically;
# use at least 32 characters and never reuse DB_PASSWORD.
JWT_SECRET=
JWT_ISSUER=bayer-westphalian-campaign-platform
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Exact comma-separated HTTPS origins, without paths or trailing slashes.
CORS_ALLOWED_ORIGINS=

# One-time first administrator bootstrap. Enable for one startup only, then disable and remove
# the password from the deployment secret store. Existing accounts are never modified.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=Production Administrator

# HTTPS is terminated by the trusted reverse proxy
HTTPS_REQUIRED=true
HTTPS_HSTS_ENABLED=true
HTTPS_HSTS_MAX_AGE_SECONDS=31536000
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERTIFICATE_PATH=
TLS_PRIVATE_KEY_PATH=

# Production endpoint exposure and shutdown
OPENAPI_ENABLED=false
SWAGGER_UI_ENABLED=false
SHUTDOWN_TIMEOUT=30s

# Production operational logging (stdout/stderr with Docker rotation)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APPLICATION=INFO
LOG_LEVEL_SPRING=WARN
LOG_LEVEL_HIBERNATE_SQL=WARN
LOG_LEVEL_SCHEDULER=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Abuse and campaign safeguards
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_FAILURE_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_LOCKOUT_MINUTES=15
CONTACT_MONTHLY_LIMIT=3
CONTACT_RETRY_LIMIT=3
UNINTERESTED_EXCLUSION_DAYS=90
REMINDER_PROCESSING_CRON=0 */15 * * * *
REMINDER_PROCESSING_ZONE=UTC

# Sending stays disabled until a real provider is intentionally configured
PROVIDER_REAL_SENDING_ENABLED=false
EMAIL_PROVIDER_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER_MODE=disabled
SMS_API_KEY=

# Persistent consent evidence mount used by docker-compose.prod.yml
FILE_STORAGE_MODE=filesystem
FILE_STORAGE_LOCAL_PATH=/app/data/consent-evidence
FILE_STORAGE_MAX_BYTES=10485760
CONSENT_EVIDENCE_VOLUME_NAME=bwc_consent_evidence
