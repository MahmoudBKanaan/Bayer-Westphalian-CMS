# Backend environment template (Sprint 17 item 688).
# Copy to backend/.env for local runs. Do not commit real secrets.
# Full catalog: docs/deployment/environment-variables.md

# Active Spring profile: dev, test, or prod
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080
# Dev origins for Vite. Production must use https:// only (no *).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (application)
DB_URL=jdbc:postgresql://localhost:5432/bwc_campaign
DB_USERNAME=bwc_app
DB_PASSWORD=bwc_app

# Docker Compose PostgreSQL (when using root docker-compose.yml)
POSTGRES_DB=bwc_campaign
POSTGRES_USER=bwc_app
POSTGRES_PASSWORD=bwc_app
POSTGRES_PORT=5432

# JWT authentication
JWT_ISSUER=bayer-westphalian-campaign-platform
# Local placeholder — production requires a strong secret (≥32 chars recommended; see SecretPresenceValidator).
JWT_SECRET=change-me-for-local-development
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# HTTPS (prod defaults true via application-prod.yml)
HTTPS_REQUIRED=false
HTTPS_HSTS_ENABLED=false
HTTPS_HSTS_MAX_AGE_SECONDS=31536000

# Login rate limiting
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_FAILURE_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_LOCKOUT_MINUTES=15

# Campaign communication limits
CONTACT_MONTHLY_LIMIT=3
CONTACT_RETRY_LIMIT=3
UNINTERESTED_EXCLUSION_DAYS=90
REMINDER_PROCESSING_CRON=0 */15 * * * *

# Email provider. Use mock in dev/test.
PROVIDER_REAL_SENDING_ENABLED=false
EMAIL_PROVIDER_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# SMS provider. Use mock in dev/test.
SMS_PROVIDER_MODE=mock
SMS_API_KEY=

# Consent evidence / file storage
FILE_STORAGE_MODE=local
FILE_STORAGE_LOCAL_PATH=./data/files
