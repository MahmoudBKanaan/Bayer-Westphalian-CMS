# Frontend environment template (Sprint 17 item 688).
# Copy to frontend/.env for local Vite. Do not commit real secrets.
# Full catalog: docs/deployment/environment-variables.md

# Backend API base URL (must include /api when the Spring API is mounted there)
VITE_API_BASE_URL=http://localhost:8080/api

# Logical environment label for UI/build tooling (dev | staging | prod)
VITE_APP_ENV=dev
