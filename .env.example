# =============================================================================
# Bayer-Westphalian Campaign Management Platform — environment variable template
# Sprint 17 item 688
#
# Copy sections into real files (never commit secrets):
#   backend/.env          ← backend/Spring Boot
#   frontend/.env         ← Vite frontend
#   shell / Compose env   ← Docker Compose postgres overrides (optional)
#
# Also see:
#   backend/.env.example
#   frontend/.env.example
#   docs/deployment/environment-variables.md
# Secrets handling details: item 689 / docs/architecture/security-hardening.md
# =============================================================================

# -----------------------------------------------------------------------------
# Spring / runtime profile
# -----------------------------------------------------------------------------
# dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
SERVER_PORT=8080
# Dev: localhost Vite origins. Prod: explicit https:// frontend origins only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# PostgreSQL (application JDBC)
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/bwc_campaign
DB_USERNAME=bwc_app
DB_PASSWORD=bwc_app

# -----------------------------------------------------------------------------
# Docker Compose PostgreSQL (root docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_DB=bwc_campaign
POSTGRES_USER=bwc_app
POSTGRES_PASSWORD=bwc_app
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# JWT authentication
# -----------------------------------------------------------------------------
JWT_ISSUER=bayer-westphalian-campaign-platform
# Local placeholder only — production requires a strong secret (see item 543 / 665).
JWT_SECRET=change-me-for-local-development
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# -----------------------------------------------------------------------------
# HTTPS enforcement (production profile defaults true)
# -----------------------------------------------------------------------------
HTTPS_REQUIRED=false
HTTPS_HSTS_ENABLED=false
HTTPS_HSTS_MAX_AGE_SECONDS=31536000

# -----------------------------------------------------------------------------
# Login rate limiting
# -----------------------------------------------------------------------------
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_FAILURE_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# Campaign / contact rules
# -----------------------------------------------------------------------------
CONTACT_MONTHLY_LIMIT=3
CONTACT_RETRY_LIMIT=3
UNINTERESTED_EXCLUSION_DAYS=90
REMINDER_PROCESSING_CRON=0 */15 * * * *

# -----------------------------------------------------------------------------
# Communication providers (mock in local/dev)
# -----------------------------------------------------------------------------
PROVIDER_REAL_SENDING_ENABLED=false
EMAIL_PROVIDER_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER_MODE=mock
SMS_API_KEY=

# -----------------------------------------------------------------------------
# Consent evidence / file storage
# -----------------------------------------------------------------------------
FILE_STORAGE_MODE=local
FILE_STORAGE_LOCAL_PATH=./data/files

# -----------------------------------------------------------------------------
# Frontend (Vite) — also documented in frontend/.env.example
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_ENV=dev
